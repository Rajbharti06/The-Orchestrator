# ============================================================
# Orchestrator X - Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
MOCK=false  # Set to true to run without API keys (deterministic mock responses)

# --- LLM Providers (configure at least one) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
OLLAMA_BASE_URL=http://localhost:11434  # For local Ollama models

# --- Provider Routing (optional overrides) ---
PLANNING_PROVIDER=anthropic       # Provider for planning tasks
PLANNING_MODEL=claude-opus-4-5    # Model for planning
CODING_PROVIDER=anthropic         # Provider for code generation
CODING_MODEL=claude-sonnet-4-5    # Model for code generation
QA_PROVIDER=groq                  # Provider for QA/quick checks
QA_MODEL=llama-3.1-70b-versatile  # Model for QA

# --- GitHub ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo-name

# --- Deployment Targets ---
VERCEL_TOKEN=...
RAILWAY_TOKEN=...
RENDER_API_KEY=...
FLY_API_TOKEN=...

# --- Database (for memory/lessons persistence) ---
# Defaults to SQLite in memory/ directory if not set
DATABASE_URL=sqlite:./memory/orchestrator.db

# --- MCP ---
MCP_PORT=3001       # Port for MCP server
PROXY_PORT=3002     # Port for AI proxy (OpenAI-compatible)

# --- Security ---
JWT_SECRET=change-me-in-production
API_KEY=your-api-key-for-securing-endpoints

# --- Feature Flags ---
ENABLE_AUTONOMOUS_LOOP=true
AUTONOMOUS_INTERVAL_MS=600000   # 10 minutes
ENABLE_SECURITY_SCAN=true
ENABLE_QUALITY_GATE=true
MAX_FIX_ATTEMPTS=3
