# ============================================================
# Orchestrator X - Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
MOCK=false  # Set to true to run without API keys (deterministic mock responses)

# --- LLM Providers ---
# REQUIRED (at minimum one of): ANTHROPIC or FEATHERLESS
# REMOVED: xAI (grok-beta — not specialized for code), Mistral (outperformed by DeepSeek),
#           OpenRouter (redundant meta-layer adding latency/markup)

# Primary: Claude Opus 4.7 for planning/reasoning, Sonnet 4.6 for coding, Haiku for fast
ANTHROPIC_API_KEY=sk-ant-...

# Primary coding: Featherless → MiniMax-M2.5 (80.2% SWE-Bench #1 open-source 2026)
# Also: Qwen3-235B (planning), DeepSeek-R1 (reasoning), Kimi-K2 (general)
# Free tier: https://featherless.ai
FEATHERLESS_API_KEY=sk-...

# Ultra-fast inference (sub-200ms), Llama 3.3 70B — ideal for fast/QA tasks
GROQ_API_KEY=gsk_...

# DeepSeek R1: 90% AIME — best open-source reasoning. V3: top-tier coding. Very cheap.
DEEPSEEK_API_KEY=sk-...

# Gemini 2.5 Pro: 2M token context — uniquely suited for full codebase analysis
GEMINI_API_KEY=AIza...

# Ollama: local/offline/private — zero cost, full control
OLLAMA_BASE_URL=http://localhost:11434

# --- Provider Routing (optional overrides) ---
# Defaults are auto-selected by benchmark performance:
# coding → featherless (MiniMax-M2.5), planning → anthropic (Opus 4.7)
# reasoning → deepseek (R1), longcontext → gemini (2.5-pro), fast → groq
PLANNING_PROVIDER=anthropic
PLANNING_MODEL=claude-opus-4-7
CODING_PROVIDER=featherless
CODING_MODEL=MiniMaxAI/MiniMax-M2.5
QA_PROVIDER=groq
QA_MODEL=llama-3.3-70b-versatile
REASONING_PROVIDER=deepseek
REASONING_MODEL=deepseek-reasoner

# --- GitHub ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo-name

# --- Deployment Targets ---
VERCEL_TOKEN=...
RAILWAY_TOKEN=...
RENDER_API_KEY=...
FLY_API_TOKEN=...

# --- Database (for memory/lessons persistence) ---
# Defaults to SQLite in memory/ directory if not set
DATABASE_URL=sqlite:./memory/orchestrator.db

# --- MCP ---
MCP_PORT=3001       # Port for MCP server
PROXY_PORT=3002     # Port for AI proxy (OpenAI-compatible)

# --- Security ---
JWT_SECRET=change-me-in-production
API_KEY=your-api-key-for-securing-endpoints

# --- Feature Flags ---
ENABLE_AUTONOMOUS_LOOP=true
AUTONOMOUS_INTERVAL_MS=600000   # 10 minutes
ENABLE_SECURITY_SCAN=true
ENABLE_QUALITY_GATE=true
MAX_FIX_ATTEMPTS=3
